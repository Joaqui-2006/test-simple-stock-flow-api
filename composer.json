{
    "name": "code-sena/test-simple-stock-flow-api",
    "type": "project",
    "description": "Backend en PHP (Laravel) para Simple Stock Flow en Arquitectura Onion",
    "require": {
        "php": "^8.2",
        "brick/math": "^0.12",
        "firebase/php-jwt": "^6.10",
        "laravel/framework": "^11.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^2.9",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0",
        "qossmic/deptrac-shim": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "deptrac": "vendor/bin/deptrac analyse --config-file=depfile.yaml"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}